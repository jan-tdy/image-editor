[Desktop Entry]
Type=Application
Name=PyView Editor
GenericName=Image Viewer & Editor
Comment=Fast, IrfanView-style image and video viewer/editor
Exec=pyview-editor %F
Icon=pyview-editor
Terminal=false
Categories=Graphics;Photography;Viewer;
MimeType=image/jpeg;image/png;image/bmp;image/gif;image/webp;image/tiff;image/vnd.microsoft.icon;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;
StartupNotify=true
